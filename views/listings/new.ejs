<% layout("/layouts/boilerplate") %>


  <body>
    <div class="row">
      <h1>Create a Listing</h1>

      <form action="/listing" method="POST" class="needs-validation" novalidate>
        <!-- Title -->
        <div class="mb-3">
          <label for="title" class="form-lable">Title</label>
          <input type="text" placeholder="Enter title" name="title" class="form-control" required />
          <div class="valid-feedback">Title looks good !</div>
          <div class="invalid-feedback">Please enter valid title</div>
        </div>


        <!-- Description -->

        <div class="mb-3">
          <label for="description" class="form-lable">Description</label>
          <input type="text" placeholder="Enter Description" name="description" class="form-control" k required>
          <div class="valid-feedback">Discription looks good !</div>
          <div class="invalid-feedback">Please enter valid discription</div>
        </div>

        <!-- Image Link -->
        <div class="mb-3">
          <label for="image" class="form-label">Image Link</label>
          <input type="text" name="image" placeholder="Enter image url" class="form-control" required>
          <div class="valid-feedback">Image link looks good !</div>
          <div class="invalid-feedback">Please enter valid Image link</div>
        </div>

        <!--Price  -->

        <div class="mb-3">
          <label for="price" class="form-lable">Price</label>
          <input type="text" placeholder="Enter price " name="price" class="form-control" required>
          <div class="valid-feedback">Price looks good !</div>
          <div class="invalid-feedback">Please enter valid price</div>
        </div>


        <!-- location -->

        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input type="text" placeholder="Enter location" name="location" class="form-control" required>
          <div class="valid-feedback">Location looks good !</div>
          <div class="invalid-feedback">Please enter valid location</div>
        </div>


        <!-- Countru -->
        <div class="mb-3">
          <label for="country" class="form-label">Country</label>
          <input type="text" placeholder="Enter Country" name="country" class="form-control" required>
          <div class="valid-feedback">Country looks good !</div>
          <div class="invalid-feedback">Please enter valid country</div>
        </div>

        <!-- Submit button -->
        <div class="mb-3">
          <button type="submit" class="btn btn-danger new-btn">Add</button>

        </div>
      </form>
    </div>

  </body>