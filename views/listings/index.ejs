<% layout("/layouts/boilerplate") %>

  <body>
    <h1>All Listing</h1>
    <br>

    <!-- Card  -->
    <div class="row">
      <% for (let listing of allListings) { %>
        <div class="card" style="width: 18rem;">
          <img src="<%= listing.image %>" class="card-img-top" alt="listing image">
          <div class="card-body">
            <p class="card-text">
            <p>
              <%= listing.title %>
            </p>
            <p>
              <%= listing.price.toLocaleString("en-IN") %>
            </p>
            </p>
          </div>
        </div>
        <% } %>
    </div>
  </body>