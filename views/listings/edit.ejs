<% layout("/layouts/boilerplate") %>

  <body>
    </h1>
    <div class="row mt-3">
      <div class="col-8 offset-2">
        <h1>Editing <%=particularData.id %>
        </h1>

        <form action="/listing/<%= particularData.id %>?_method=PUT" method="POST">

          <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="Listing[title]" value="<%=particularData.title %>" class="form-control">

          </div>
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>

            <input type="text" name="Listing[description]" value="<%= particularData.description %>"
              class="form-control">

          </div>

          <div class="mb-3">
            <label for="image" class="form-label">Image Link</label>
            <input type="text" name="Listing[image]" value="<%= particularData.image %>" class="form-control">
          </div>

          <div class="mb-3">
            <label for="price" class="form-label">Price</label>

            <input type="number" name="Listing[price]" value="<%= particularData.price %>" class="form-control">

          </div>
          <div class="row">
            <div class="mb-3 col-md-6">
              <label for="country" class="form-label">Country</label>

              <input type="text" name="Listing[country]" value="<%= particularData.country %>" class="form-control">

            </div>
            <div class="mb-3 col-md-6">
              <label for="location" class="form-label">Location</label>

              <input type="text" name="Listing[location]" value="<%= particularData.location %>" class="form-control">

            </div>
          </div>
          <div class="mb-3">

            <button type="submit" class="btn btn-danger mt-3 edit-btn">Update Listing</button>

          </div>

        </form>
      </div>
    </div>
  </body>