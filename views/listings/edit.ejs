<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Data</title>
</head>
<body>
      <h1>Editing <%=particularData.id %></h1>
     
     <form action="/listing/<%= particularData.id %>?_method=PUT" method="POST">
      <input type="text" name="Listing[title]" value="<%=particularData.title %>">
      <br>
      <br>
      <input type="text" name="Listing[description]" value="<%= particularData.description %>">
 <br>
      <br>
    <input type="number" name="Listing[price]" value="<%= particularData.price %>">
 <br>
      <br>
    <input type="text" name="Listing[country]" value="<%= particularData.country %>">
 <br>
      <br>
    <input type="text" name="Listing[location]" value="<%= particularData.location %>">
 <br>
      <br>
    <button type="submit">Update Listing</button>
   
     </form>
</body>
</html>